# shoresh-base — the heavy, slow-changing layers, baked into a TAGGED image so
# they are pinned (an image's layers are never reclaimed by BuildKit build-cache
# GC, unlike inline build cache). The app image (Dockerfile) builds FROM this, so
# editing app code never re-downloads model weights or re-parses the corpus.
#
# REBUILD THIS BASE only when requirements*.txt or the spine/ package
# change:
#   docker build -f Dockerfile.base --build-arg SEARCH_EMBEDDER=berel \
#     -t shoresh-base:latest .
FROM python:3.13-slim
WORKDIR /app
ENV HOME=/root
ENV PYTHONPATH=/app

COPY requirements.txt ./
ARG SEARCH_EMBEDDER=cloudflare
RUN pip install --no-cache-dir -r requirements.txt
COPY requirements-berel.txt ./
# torch from the CPU index first: the default PyPI wheel on Linux pulls the CUDA stack (several GB, no GPU on the host).
RUN if [ "$SEARCH_EMBEDDER" = "berel" ]; then \
      pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu && \
      pip install --no-cache-dir -r requirements-berel.txt; \
    fi

# Bake native model weights (~1.5 GB). In the base image these are pinned and
# never re-downloaded by app-code rebuilds.
RUN if [ "$SEARCH_EMBEDDER" = "berel" ]; then \
      python -c "from transformers import AutoModel, AutoTokenizer; \
        AutoTokenizer.from_pretrained('dicta-il/BEREL_3.0'); \
        AutoModel.from_pretrained('dicta-il/BEREL_3.0'); \
        AutoTokenizer.from_pretrained('bowphs/SPhilBerta'); \
        AutoModel.from_pretrained('bowphs/SPhilBerta')"; \
    fi

# Parse the UHB / UGNT source into spine.db (spine package + a network fetch). Built here once; the app image inherits the .db
# file. (.dockerignore keeps the source data/.db out of the context, so parse regenerates it.) The Septuagint store lxx-glaux.db is built
# locally (python -m lxx.build_glaux) and shipped to the data volume (/data/lxx-glaux.db); the CATSS-based lxx.db is no longer built (2026-10-10).
COPY spine/ ./spine/
RUN python -m spine.parse

# MACULA per-token semantics (frames / coreference) → macula-spine.db. Fetches the
# CC-BY MACULA TSVs (LFS, ~250 MB transient); references.py is needed for ref→BCV.
COPY references.py ./
COPY macula/ ./macula/
RUN python -m macula.parse

# interlinear: per-occurrence Hebrew/Greek + contextual glosses → hebrew_greek.db + gloss/*.db,
# plus BSB-publishing/bsb-data-output (translation text + headings — see interlinear/serve.py's
# module docstring). No dependency on the study-app eng_bsb.db/sdbh.db/sdbg.db assets previously
# fetched here. Each build step fetches its own (pinned) source data first, idempotently.
COPY interlinear/ ./interlinear/
RUN python -m interlinear.fetch \
 && python -m interlinear.build_hebrew_greek \
 && python -m interlinear.build_gloss
